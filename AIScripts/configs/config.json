{
  "model": {
    "name": "gpt2-small",
    "type": "text-generation",
    "base_model": "gpt2"
  },
  "training": {
    "epochs": 3,
    "batch_size": 8,
    "learning_rate": 5e-5,
    "warmup_steps": 500,
    "max_length": 512,
    "save_steps": 1000
  },
  "dataset": {
    "path": "AIScripts/data/training_data.txt",
    "validation_split": 0.1,
    "test_split": 0.1
  },
  "output": {
    "model_path": "AIScripts/output/finetuned_model",
    "coreml_path": "AIScripts/output/model.mlmodel",
    "logs_path": "AIScripts/output/logs"
  },
  "fine_tuning": {
    "task": "text-generation",
    "prompt_template": "Generate code based on: {input}",
    "max_new_tokens": 256
  }
}
